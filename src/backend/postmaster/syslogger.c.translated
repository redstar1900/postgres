/*-------------------------------------------------------------------------*
 *
 * syslogger.c
 *
 * 系统日志记录器（syslogger）出现在Postgres 8.0版本中。它通过重定向到管道来捕获
 * 来自postmaster、后端和其他子进程的所有stderr输出，并将其写入一组日志文件。
 * 可以在postgresql.conf中配置日志文件的大小和老化限制。当达到或超过这些限制时，
 * 当前日志文件将被关闭，然后创建一个新文件（轮换）。
 * 日志文件存储在一个子目录中（可在postgresql.conf中配置），使用用户可选的命名方案。
 *
 * 作者: Andreas Pflug <pgadmin@pse-consulting.de>
 *
 * 版权所有 (c) 2004-2024，PostgreSQL全球开发组
 *
 *
 * 标识
 *    src/backend/postmaster/syslogger.c
 *
 *-------------------------------------------------------------------------*
 */
#include "postgres.h"

#include <fcntl.h>
#include <limits.h>
#include <signal.h>
#include <time.h>
#include <unistd.h>
#include <sys/stat.h>
#include <sys/time.h>

#include "common/file_perm.h"
#include "lib/stringinfo.h"
#include "libpq/pqsignal.h"
#include "miscadmin.h"
#include "nodes/pg_list.h"
#include "pgstat.h"
#include "pgtime.h"
#include "port/pg_bitutils.h"
#include "postmaster/interrupt.h"
#include "postmaster/postmaster.h"
#include "postmaster/syslogger.h"
#include "storage/dsm.h"
#include "storage/fd.h"
#include "storage/ipc.h"
#include "storage/latch.h"
#include "storage/pg_shmem.h"
#include "tcop/tcopprot.h"
#include "utils/guc.h"
#include "utils/memutils.h"
#include "utils/ps_status.h"

/*
 * 我们将数据读入一个是块大小两倍的临时缓冲区，这样在处理后任何剩余的片段
 * 都可以向下移动到前面，并且我们仍然有空间读取一个完整的块。
 */
#define READ_BUF_SIZE (2 * PIPE_CHUNK_SIZE)

/* 日志轮换信号文件路径，相对于 $PGDATA */
#define LOGROTATE_SIGNAL_FILE	"logrotate"


/*
 * GUC参数。Logging_collector在postmaster启动后不能更改，但其他参数可以在SIGHUP时更改。
 */
bool	Logging_collector = false;
int		Log_RotationAge = HOURS_PER_DAY * MINS_PER_HOUR;
int		Log_RotationSize = 10 * 1024;
char	*Log_directory = NULL;
char	*Log_filename = NULL;
bool	Log_truncate_on_rotation = false;
int		Log_file_mode = S_IRUSR | S_IWUSR;

extern bool redirection_done;

/*
 * 私有状态
 */
static pg_time_t next_rotation_time;
static bool pipe_eof_seen = false;
static bool rotation_disabled = false;
static FILE *syslogFile = NULL;
static FILE *csvlogFile = NULL;
static FILE *jsonlogFile = NULL;
NON_EXEC_STATIC pg_time_t first_syslogger_file_time = 0;
static char *last_sys_file_name = NULL;
static char *last_csv_file_name = NULL;
static char *last_json_file_name = NULL;

/*
 * 用于保存来自不同后端的部分消息的缓冲区。
 *
 * 保持NBUFFER_LISTS个这些列表，给定源pid的条目位于编号为(pid % NBUFFER_LISTS)的列表中，
 * 以便减少我们必须为任何一个传入消息检查的条目数量。
 * 对于相同的源pid，永远不能有多个条目。
 *
 * 非活动缓冲区不会从其列表中移除，而是保留以供重用。
 * 非活动缓冲区的pid == 0，data的内容未定义。
 */
typedef struct
{
	int32	pid;			/* 源进程的PID */
	StringInfoData data;		/* 累积的数据，作为StringInfo */
} save_buffer;

#define NBUFFER_LISTS 256
static List *buffer_lists[NBUFFER_LISTS];

/* 这些必须为EXEC_BACKEND情况导出...有点烦人 */
#ifndef WIN32
int		syslogPipe[2] = {-1, -1};
#else
HANDLE	syslogPipe[2] = {0, 0};
#endif

#ifdef WIN32
static HANDLE threadHandle = 0;
static CRITICAL_SECTION sysloggerSection;
#endif

/*
 * 由中断处理程序设置的标志，以便在主循环中稍后处理。
 */
static volatile sig_atomic_t rotation_requested = false;


/* 本地子例程 */
#ifdef EXEC_BACKEND
static int	syslogger_fdget(FILE *file);
static FILE *	syslogger_fdopen(int fd);
#endif
static void process_pipe_input(char *logbuffer, int *bytes_in_logbuffer);
static void flush_pipe_input(char *logbuffer, int *bytes_in_logbuffer);
static FILE *logfile_open(const char *filename, const char *mode,
			  bool allow_errors);

#ifdef WIN32
static unsigned int __stdcall pipeThread(void *arg);
#endif
static void logfile_rotate(bool time_based_rotation, int size_rotation_for);
static bool logfile_rotate_dest(bool time_based_rotation,
			  int size_rotation_for, pg_time_t fntime,
			  int target_dest, char **last_file_name,
			  FILE **logFile);
static char *logfile_getname(pg_time_t timestamp, const char *suffix);
static void set_next_rotation_time(void);
static void sigUsr1Handler(SIGNAL_ARGS);
static void update_metainfo_datafile(void);

typedef struct
{
	int	syslogFile;
	int	csvlogFile;
	int	jsonlogFile;
} SysloggerStartupData;

/*
 * 系统日志记录器进程的主入口点
 * 在EXEC_BACKEND情况下，argc/argv参数才有效。
 */
void
SysLoggerMain(char *startup_data, size_t startup_data_len)
{
#ifndef WIN32
	char	logbuffer[READ_BUF_SIZE];
	int	bytes_in_logbuffer = 0;
#endif
	char	*currentLogDir;
	char	*currentLogFilename;
	int	currentLogRotationAge;
	pg_time_t	now;
	WaitEventSet *wes;

	/*
	 * 重新打开由SysLogger_Start()打开的错误输出文件。
	 *
	 * 我们期望这将始终成功，这可能过于乐观，但如果失败，我们也没有太多方法来报告问题。
	 * 按照当前的代码，如果失败，我们将在空指针解引用时崩溃...
	 */
#ifdef EXEC_BACKEND
	{
		SysloggerStartupData *slsdata = (SysloggerStartupData *) startup_data;

		Assert(startup_data_len == sizeof(*slsdata));
		syslogFile = syslogger_fdopen(slsdata->syslogFile);
		csvlogFile = syslogger_fdopen(slsdata->csvlogFile);
		jsonlogFile = syslogger_fdopen(slsdata->jsonlogFile);
	}
#else
	Assert(startup_data_len == 0);
#endif

	/*
	 * 现在我们已经完成了读取启动数据，释放postmaster的工作内存上下文。
	 */
	if (PostmasterContext)
	{
		MemoryContextDelete(PostmasterContext);
		PostmasterContext = NULL;
	}

	now = MyStartTime;

	MyBackendType = B_LOGGER;
	init_ps_display(NULL);

	/*
	 * 如果我们重启了，我们的stderr已经被重定向到我们自己的输入管道。
	 * 这当然没有什么用，更不用说它会干扰检测管道EOF了。
	 * 将stderr指向/dev/null。这假设在syslogger中生成的所有有趣消息都将通过elog.c并发送到write_syslogger_file。
	 */
	if (redirection_done)
	{
		int	fd = open(DEVNULL, O_WRONLY, 0);

		/*
		 * 这些关闭操作可能看起来是多余的，但它们不是：我们要确保即使打开失败，管道也会被关闭。
		 * 我们可以在stderr指向无处的情况下运行，但我们不能承受有额外的管道输入描述符挂起。
		 *
		 * 由于我们只是尝试将这些重置为指向DEVNULL，因此在这里检查close/dup2调用的失败没有多大意义，
		 * 如果它们失败，那么文件描述符可能已关闭，任何写入都将进入位桶。
		 */
		close(STDOUT_FILENO);
		close(STDERR_FILENO);
		if (fd != -1)
		{
			(void) dup2(fd, STDOUT_FILENO);
			(void) dup2(fd, STDERR_FILENO);
			close(fd);
		}
	}

	/*
	 * Syslogger自己的stderr不能是syslogPipe，所以如果我们没有刚刚关闭它，将其设置回文本模式。
	 * （在SubPostmasterMain中将其设置为二进制。）
	 */
#ifdef WIN32
	else
		_setmode(STDERR_FILENO, _O_TEXT);
#endif

	/*
	 * 同时关闭我们的管道写入端副本。这是检测管道EOF所必需的。
	 * （但请注意，在重启情况下，postmaster已经这样做了。）
	 */
#ifndef WIN32
	if (syslogPipe[1] >= 0)
		close(syslogPipe[1]);
	syslogPipe[1] = -1;
#else
	if (syslogPipe[1])
		CloseHandle(syslogPipe[1]);
	syslogPipe[1] = 0;
#endif

	/*
	 * 正确接受或忽略postmaster可能发送给我们的信号
	 *
	 * 注意：我们忽略所有终止信号，而是仅在所有上游进程都消失时退出，以确保我们不会错过任何崩溃后端的最后消息...
	 */

	pqsignal(SIGHUP, SignalHandlerForConfigReload); /* 设置标志以读取配置文件 */
	pqsignal(SIGINT, SIG_IGN);
	pqsignal(SIGTERM, SIG_IGN);
	pqsignal(SIGQUIT, SIG_IGN);
	pqsignal(SIGALRM, SIG_IGN);
	pqsignal(SIGPIPE, SIG_IGN);
	pqsignal(SIGUSR1, sigUsr1Handler);	/* 请求日志轮换 */
	pqsignal(SIGUSR2, SIG_IGN);

	/*
	 * 重置一些postmaster接受但此处不接受的信号
	 */
	pqsignal(SIGCHLD, SIG_DFL);

	sigprocmask(SIG_SETMASK, &UnBlockSig, NULL);

#ifdef WIN32
	/* 启动单独的数据传输线程 */
	InitializeCriticalSection(&sysloggerSection);
	EnterCriticalSection(&sysloggerSection);

	threadHandle = (HANDLE) _beginthreadex(NULL, 0, pipeThread, NULL, 0, NULL);
	if (threadHandle == 0)
		eblog(FATAL, "无法创建系统日志记录器数据传输线程: %m");
#endif					/* WIN32 */

	/*
	 * 记住活动日志文件的名称。我们从参考时间重新计算它们，因为在EXEC_BACKEND情况下，
	 * 只传递pg_time_t比传递整个文件路径要便宜得多。
	 */
	last_sys_file_name = logfile_getname(first_syslogger_file_time, NULL);
	if (csvlogFile != NULL)
		last_csv_file_name = logfile_getname(first_syslogger_file_time, ".csv");
	if (jsonlogFile != NULL)
		last_json_file_name = logfile_getname(first_syslogger_file_time, ".json");

	/* 记住活动日志文件参数 */
	currentLogDir = pstrdup(Log_directory);
	currentLogFilename = pstrdup(Log_filename);
	currentLogRotationAge = Log_RotationAge;
	/* 设置下一次计划轮换时间 */
	set_next_rotation_time();
	update_metainfo_datafile();

	/*
	 * 重置whereToSendOutput，就像postmaster会做的那样（但在我们分叉时还没有做）。
	 * 这可以防止来自syslogger本身的消息重复输出。
	 */
	whereToSendOutput = DestNone;

	/*
	 * 设置一个可重用的WaitEventSet对象，我们将使用它来等待我们的latch，
	 * 和（除Windows外）我们的套接字。
	 *
	 * 与所有其他postmaster子进程不同，我们将忽略postmaster死亡，因为我们想要收集所有后端的最终日志输出，
	 * 然后最后退出。我们将通过运行直到在syslog管道上看到EOF来做到这一点，这意味着所有其他后端都已退出（包括postmaster）。
	 */
	wes = CreateWaitEventSet(NULL, 2);
	AddWaitEventToSet(wes, WL_LATCH_SET, PGINVALID_SOCKET, MyLatch, NULL);
#ifndef WIN32
	AddWaitEventToSet(wes, WL_SOCKET_READABLE, syslogPipe[0], NULL, NULL);
#endif

	/* 主工作循环 */
	for (;;)
	{
		bool			time_based_rotation = false;
		int			size_rotation_for = 0;
		long			cur_timeout;
		WaitEvent		event;

#ifndef WIN32
		int			rc;
#endif

		/* 清除任何已经挂起的唤醒 */
		ResetLatch(MyLatch);

		/*
		 * 处理最近收到的任何请求或信号。
		 */
		if (ConfigReloadPending)
		{
			ConfigReloadPending = false;
			ProcessConfigFile(PGC_SIGHUP);

			/*
			 * 检查日志目录或文件名模式是否在postgresql.conf中更改。如果是，强制轮换以确保我们
			 * 在正确的位置写入日志文件。
			 */
			if (strcmp(Log_directory, currentLogDir) != 0)
			{
				pfree(currentLogDir);
				currentLogDir = pstrdup(Log_directory);
				rotation_requested = true;

				/*
				 * 此外，如果目录不存在，则创建新目录；忽略错误
				 */
				(void) MakePGDirectory(Log_directory);
			}
			if (strcmp(Log_filename, currentLogFilename) != 0)
			{
				pfree(currentLogFilename);
				currentLogFilename = pstrdup(Log_filename);
				rotation_requested = true;
			}

			/*
			 * 如果CSVLOG输出刚刚打开或关闭，并且我们需要相应地打开或关闭csvlogFile，则强制轮换。
			 */
			if (((Log_destination & LOG_DESTINATION_CSVLOG) != 0) !=
				(csvlogFile != NULL))
				rotation_requested = true;

			/*
			 * 如果JSONLOG输出刚刚打开或关闭，并且我们需要相应地打开或关闭jsonlogFile，则强制轮换。
			 */
			if (((Log_destination & LOG_DESTINATION_JSONLOG) != 0) !=
				(jsonlogFile != NULL))
				rotation_requested = true;

			/*
			 * 如果轮换时间参数更改，重置下一次轮换时间，但不立即强制轮换。
			 */
			if (currentLogRotationAge != Log_RotationAge)
			{
				currentLogRotationAge = Log_RotationAge;
				set_next_rotation_time();
			}

			/*
			 * 如果我们遇到了禁用轮换的失败，在SIGHUP后重新启用轮换尝试，并立即强制一次。
			 */
			if (rotation_disabled)
			{
				rotation_disabled = false;
				rotation_requested = true;
			}

			/*
			 * 在重新加载配置时强制重写最后一个日志文件名。即使rotation_requested为false，
			 * log_destination也可能已更改，我们不想等待下一次文件轮换。
			 */
			update_metainfo_datafile();
		}

		if (Log_RotationAge > 0 && !rotation_disabled)
		{
			/* 如果到了时间，执行日志文件轮换 */
			now = (pg_time_t) time(NULL);
			if (now >= next_rotation_time)
				rotation_requested = time_based_rotation = true;
		}

		if (!rotation_requested && Log_RotationSize > 0 && !rotation_disabled)
		{
			/* 如果文件太大，执行轮换 */
			if (ftell(syslogFile) >= Log_RotationSize * 1024L)
			{
				rotation_requested = true;
				size_rotation_for |= LOG_DESTINATION_STDERR;
			}
			if (csvlogFile != NULL &&
				ftell(csvlogFile) >= Log_RotationSize * 1024L)
			{
				rotation_requested = true;
				size_rotation_for |= LOG_DESTINATION_CSVLOG;
			}
			if (jsonlogFile != NULL &&
				ftell(jsonlogFile) >= Log_RotationSize * 1024L)
			{
				rotation_requested = true;
				size_rotation_for |= LOG_DESTINATION_JSONLOG;
			}
		}

		if (rotation_requested)
		{
			/*
			 * 当两个值都为零时强制轮换。这表示请求是由pg_rotate_logfile()或"pg_ctl logrotate"发送的。
			 */
			if (!time_based_rotation && size_rotation_for == 0)
				size_rotation_for = LOG_DESTINATION_STDERR |
					LOG_DESTINATION_CSVLOG |
					LOG_DESTINATION_JSONLOG;
			logfile_rotate(time_based_rotation, size_rotation_for);
		}

		/*
		 * 计算到下一次基于时间的轮换的时间，这样我们就不会睡得比这更长。我们假设上面获得的"now"值仍然足够接近。
		 * 请注意，我们必须等到调用logfile_rotate()之后才能进行此计算，因为它会推进next_rotation_time。
		 *
		 * 还要注意，我们需要注意超时计算中的溢出：对于Log_RotationAge的大设置，
		 * next_rotation_time可能在未来超过INT_MAX毫秒。在这种情况下，我们将等待不超过INT_MAX毫秒，然后再试一次。
		 */
		if (Log_RotationAge > 0 && !rotation_disabled)
		{
			pg_time_t		delay;

			delay = next_rotation_time - now;
			if (delay > 0)
			{
				if (delay > INT_MAX / 1000)
					delay = INT_MAX / 1000;
				cur_timeout = delay * 1000L;	/* 毫秒 */
			}
			else
				cur_timeout = 0;
		}
		else
			cur_timeout = -1L;

		/*
		 * 睡眠直到有事情要做
		 */
#ifndef WIN32
		rc = WaitEventSetWait(wes, cur_timeout, &event, 1,
					  WAIT_EVENT_SYSLOGGER_MAIN);

		if (rc == 1 && event.events == WL_SOCKET_READABLE)
		{
			int			bytesRead;

			bytesRead = read(syslogPipe[0],
					 logbuffer + bytes_in_logbuffer,
					 sizeof(logbuffer) - bytes_in_logbuffer);
			if (bytesRead < 0)
			{
				if (errno != EINTR)
					eblog(LOG,
						(errcode_for_socket_access(),
						 errmsg("无法从日志管道读取: %m")));
			}
			else if (bytesRead > 0)
			{
				bytes_in_logbuffer += bytesRead;
				process_pipe_input(logbuffer, &bytes_in_logbuffer);
				continue;
			}
			else
			{
				/*
				 * 当select()表示可读但读取了0字节时，表示管道EOF：即不再有进程持有管道的写入端。
				 * 因此，postmaster和所有后端都已关闭，我们完成了。
				 */
				pipe_eof_seen = true;

				/* 如果还有剩余数据，则立即强制输出 */
				flush_pipe_input(logbuffer, &bytes_in_logbuffer);
			}
		}
#else						/* WIN32 */

		/*
		 * 在Windows上，我们让一个单独的线程来传输数据和检测管道EOF。主线程只是醒来处理SIGHUP和轮换条件。
		 *
		 * 服务器代码通常不是线程安全的，所以我们确保一次只有一个线程处于活动状态，
		 * 方法是在不睡眠时进入临界区。
		 */
		LeaveCriticalSection(&sysloggerSection);

		(void) WaitEventSetWait(wes, cur_timeout, &event, 1,
					  WAIT_EVENT_SYSLOGGER_MAIN);

		EnterCriticalSection(&sysloggerSection);
#endif						/* WIN32 */

		if (pipe_eof_seen)
		{
			/*
			 * 在真实的stderr上看到此消息很烦人 - 所以我们将其设为DEBUG1以在正常使用中抑制。
			 */
			eblog(DEBUG1,
				 (errmsg_internal("日志记录器正在关闭")));

			/*
			 * 系统日志记录器的正常退出点。注意我们故意在退出前不关闭syslogFile；
			 * 这是为了允许在proc_exit内部生成elog消息的可能性。
			 * 常规的exit()将负责刷新和关闭stdio通道。
			 */
			proc_exit(0);
		}
	}
}

/*
 * Postmaster子例程，用于启动系统日志记录器子进程。
 */
int
SysLogger_Start(void)
{
	pid_t		sysloggerPid;
	char		*filename;
#ifdef EXEC_BACKEND
	SysloggerStartupData startup_data;
#endif					/* EXEC_BACKEND */

	if (!Logging_collector)
		return 0;

	/*
	 * 如果是第一次运行，创建接收stderr输出的管道。
	 *
	 * 如果系统日志记录器崩溃并需要重启，我们继续使用同一个管道（实际上必须这样做，
	 * 因为现存的后端将写入该管道）。
	 *
	 * 这意味着postmaster必须继续保持管道的读取端打开，以便我们可以将其传递给重生的系统日志记录器。
	 * 这有点笨拙，但我们别无选择。
	 *
	 * 还要注意，我们不通过调用Reserve/ReleaseExternalFD来计算管道FD。
	 * 在postmaster或系统日志记录器进程中，没有真正需要准确地计算它们，
	 * 并且管道的两端最终会在所有其他postmaster子进程中关闭。
	 */
#ifndef WIN32
	if (syslogPipe[0] < 0)
	{
		if (pipe(syslogPipe) < 0)
			eblog(FATAL,
				 (errcode_for_socket_access(),
				 errmsg("无法为syslog创建管道: %m")));
	}
#else
	if (!syslogPipe[0])
	{
		SECURITY_ATTRIBUTES sa;

		memset(&sa, 0, sizeof(SECURITY_ATTRIBUTES));
		sa.nLength = sizeof(SECURITY_ATTRIBUTES);
		sa.bInheritHandle = TRUE;

		if (!CreatePipe(&syslogPipe[0], &syslogPipe[1], &sa, 32768))
			eblog(FATAL,
				 (errcode_for_file_access(),
				 errmsg("无法为syslog创建管道: %m")));
	}
#endif

	/*
	 * 如果日志目录不存在，则创建它；忽略错误
	 */
	(void) MakePGDirectory(Log_directory);

	/*
	 * 初始日志文件在postmaster中创建，以验证Log_directory是可写的。
	 * 我们保存引用时间，以便系统日志记录器子进程可以重新计算此文件名。
	 *
	 * 在系统日志记录器重启期间重新执行此操作可能看起来有点奇怪，
	 * 但我们必须这样做，因为postmaster在前一次fork后关闭了syslogFile（记住旧文件无论如何都是不正确的）。
	 * 注意我们在这里总是追加，我们不会覆盖任何现有文件。
	 * 这与正常规则一致，因为根据定义，这不是基于时间的轮换。
	 */
	first_syslogger_file_time = time(NULL);

	filename = logfile_getname(first_syslogger_file_time, NULL);

	syslogFile = logfile_open(filename, "a", false);

	pfree(filename);

	/*
	 * 同样，对于初始CSV日志文件，如果启用了的话。（注意，即使仅名义上启用了CSV输出，
	 * 我们也会打开syslogFile，因为某些代码路径无论如何都会写入syslogFile。）
	 */
	if (Log_destination & LOG_DESTINATION_CSVLOG)
	{
		filename = logfile_getname(first_syslogger_file_time, ".csv");

		csvlogFile = logfile_open(filename, "a", false);

		pfree(filename);
	}

	/*
	 * 同样，对于初始JSON日志文件，如果启用了的话。（注意，即使仅名义上启用了JSON输出，
	 * 我们也会打开syslogFile，因为某些代码路径无论如何都会写入syslogFile。）
	 */
	if (Log_destination & LOG_DESTINATION_JSONLOG)
	{
		filename = logfile_getname(first_syslogger_file_time, ".json");

		jsonlogFile = logfile_open(filename, "a", false);

		pfree(filename);
	}

#ifdef EXEC_BACKEND
	startup_data.syslogFile = syslogger_fdget(syslogFile);
	startup_data.csvlogFile = syslogger_fdget(csvlogFile);
	startup_data.jsonlogFile = syslogger_fdget(jsonlogFile);
	sysloggerPid = postmaster_child_launch(B_LOGGER, (char *) &startup_data, sizeof(startup_data), NULL);
#else
	sysloggerPid = postmaster_child_launch(B_LOGGER, NULL, 0, NULL);
#endif					/* EXEC_BACKEND */

	if (sysloggerPid == -1)
	{
		eblog(LOG,
			 (errmsg("无法fork系统日志记录器: %m")));
		return 0;
	}

	/* 成功，在postmaster中 */

	/* 现在重定向stderr，如果尚未完成 */
	if (!redirection_done)
	{
#ifdef WIN32
		int		fd;
#endif

		/*
		 * 在重定向时留下线索，以防用户忘记重定向处于活动状态并只查看原始stderr目标文件。
		 */
		eblog(LOG,
			 (errmsg("将日志输出重定向到日志收集器进程"),
			  errhint("未来的日志输出将出现在目录\"%s\"中。",
				  Log_directory)));

#ifndef WIN32
		fflush(stdout);
		if (dup2(syslogPipe[1], STDOUT_FILENO) < 0)
			eblog(FATAL,
				 (errcode_for_file_access(),
				 errmsg("无法重定向stdout: %m")));
		fflush(stderr);
		if (dup2(syslogPipe[1], STDERR_FILENO) < 0)
			eblog(FATAL,
				 (errcode_for_file_access(),
				 errmsg("无法重定向stderr: %m")));
		/* 现在我们完成了管道的写入端。 */
		close(syslogPipe[1]);
		syslogPipe[1] = -1;
#else

		/*
		 * 以二进制模式打开管道，并确保在dup'ed into后stderr也是二进制的，
		 * 以避免干扰管道分块协议。
		 */
		fflush(stderr);
		fd = _open_osfhandle((intptr_t) syslogPipe[1],
					_O_APPEND | _O_BINARY);
		if (dup2(fd, STDERR_FILENO) < 0)
			eblog(FATAL,
				 (errcode_for_file_access(),
				 errmsg("无法重定向stderr: %m")));
		close(fd);
		_setmode(STDERR_FILENO, _O_BINARY);

		/*
		 * 现在我们完成了管道的写入端。不应调用CloseHandle()，因为前面的close()关闭了底层句柄。
		 */
		syslogPipe[1] = 0;
#endif
		redirection_done = true;
	}

	/* postmaster永远不会写入文件；关闭它们 */
	fclose(syslogFile);
	syslogFile = NULL;
	if (csvlogFile != NULL)
	{
		fclose(csvlogFile);
		csvlogFile = NULL;
	}
	if (jsonlogFile != NULL)
	{
		fclose(jsonlogFile);
		jsonlogFile = NULL;
	}
	return (int) sysloggerPid;
}


#ifdef EXEC_BACKEND

/*
 * syslogger_fdget() -
 *
 * 获取已打开的错误输出文件的文件描述符的实用包装器。
 * 在构建fork日志收集器的命令时使用。
 */
static int
syslogger_fdget(FILE *file)
{
#ifndef WIN32
	if (file != NULL)
		return fileno(file);
	else
		return -1;
#else
	if (file != NULL)
		return (int) _get_osfhandle(_fileno(file));
	else
		return 0;
#endif					/* WIN32 */
}

/*
 * syslogger_fdopen() -
 *
 * 使用给定的文件描述符重新打开错误输出文件的实用包装器。
 * 在解析fork的日志收集器中的参数时使用。
 */
static FILE *
syslogger_fdopen(int fd)
{
	FILE	*file = NULL;

#ifndef WIN32
	if (fd != -1)
	{
		file = fdopen(fd, "a");
		setvbuf(file, NULL, PG_IOLBF, 0);
	}
#else						/* WIN32 */
	if (fd != 0)
	{
		fd = _open_osfhandle(fd, _O_APPEND | _O_TEXT);
		if (fd > 0)
		{
			file = fdopen(fd, "a");
			setvbuf(file, NULL, PG_IOLBF, 0);
		}
	}
#endif						/* WIN32 */

	return file;
}
#endif						/* EXEC_BACKEND */


/* ------------------------------
 *		管道协议处理
 * ------------------------------
 */

/*
 * 处理通过系统日志记录器管道接收的数据。
 *
 * 此例程解释了将日志消息作为（希望是原子的）块发送的日志管道协议 -
 * 这些块在此处被检测和重新组装。
 *
 * 该协议有一个以两个nul字节开始的头部，然后是16位长度、发送进程的pid和一个标志，
 * 以指示它是否是消息中的最后一个块。不完整的块会被保存，直到我们读取更多，
 * 非最终块会被累积，直到我们获得最终块。
 *
 * 所有这些都是为了避免两个问题：
 * . 部分消息被写入日志文件（混乱轮换），以及
 * . 来自不同后端的消息被交错（消息混乱）。
 *
 * 任何非协议消息都直接写出。然而，这些应该只来自非PostgreSQL源（例如，第三方库写入stderr）。
 *
 * logbuffer是数据输入缓冲区，*bytes_in_logbuffer是存在的字节数。
 * 退出时，任何尚未处理的数据都会在logbuffer中左对齐，并且*bytes_in_logbuffer会更新。
 */
static void
process_pipe_input(char *logbuffer, int *bytes_in_logbuffer)
{
	char	*cursor = logbuffer;
	int	count = *bytes_in_logbuffer;
	int	dest = LOG_DESTINATION_STDERR;

	/* 当我们有足够的头部数据时，处理数据... */
	while (count >= (int) (offsetof(PipeProtoHeader, data) + 1))
	{
		PipeProtoHeader p;
		int		chunklen;
		bits8		dest_flags;

		/* 我们有有效的头部吗？ */
		memcpy(&p, cursor, offsetof(PipeProtoHeader, data));
		dest_flags = p.flags & (PIPE_PROTO_DEST_STDERR |
					PIPE_PROTO_DEST_CSVLOG |
					PIPE_PROTO_DEST_JSONLOG);
		if (p.nuls[0] == '\0' && p.nuls[1] == '\0' &&
			p.len > 0 && p.len <= PIPE_MAX_PAYLOAD &&
			p.pid != 0 &&
			pg_number_of_ones[dest_flags] == 1)
		{
			List		*buffer_list;
			ListCell	*cell;
			save_buffer	*existing_slot = NULL,
					*free_slot = NULL;
			StringInfo	str;

			chunklen = PIPE_HEADER_SIZE + p.len;

			/* 如果我们还没有整个块，则退出循环 */
			if (count < chunklen)
				break;

			if ((p.flags & PIPE_PROTO_DEST_STDERR) != 0)
				dest = LOG_DESTINATION_STDERR;
			else if ((p.flags & PIPE_PROTO_DEST_CSVLOG) != 0)
				dest = LOG_DESTINATION_CSVLOG;
			else if ((p.flags & PIPE_PROTO_DEST_JSONLOG) != 0)
				dest = LOG_DESTINATION_JSONLOG;
			else
			{
				/* 根据头部验证，这不应该发生 */
				Assert(false);
			}

			/* 查找此源pid的任何现有缓冲区 */
			buffer_list = buffer_lists[p.pid % NBUFFER_LISTS];
			foreach(cell, buffer_list)
			{
				save_buffer *buf = (save_buffer *) lfirst(cell);

				if (buf->pid == p.pid)
				{
					existing_slot = buf;
					break;
				}
				if (buf->pid == 0 && free_slot == NULL)
					free_slot = buf;
			}

			if ((p.flags & PIPE_PROTO_IS_LAST) == 0)
			{
				/*
				 * 保存完整的非最终块在每个pid的缓冲区中
				 */
				if (existing_slot != NULL)
				{
					/* 将块添加到前面块的数据中 */
					str = &(existing_slot->data);
					appendBinaryStringInfo(str,
								 cursor + PIPE_HEADER_SIZE,
								 p.len);
				}
				else
				{
					/* 消息的第一个块，保存在新的缓冲区中 */
					if (free_slot == NULL)
					{
						/*
						 * 需要一个空闲槽位，但列表中没有，所以创建一个新的并将其扩展列表。
						 */
						free_slot = palloc(sizeof(save_buffer));
						buffer_list = lappend(buffer_list, free_slot);
						buffer_lists[p.pid % NBUFFER_LISTS] = buffer_list;
					}
					free_slot->pid = p.pid;
					str = &(free_slot->data);
					initStringInfo(str);
					appendBinaryStringInfo(str,
								 cursor + PIPE_HEADER_SIZE,
								 p.len);
				}
			}
			else
			{
				/*
				 * 最终块 --- 将其添加到该pid保存的任何内容中，无论哪种方式都将整个内容写出。
				 */
				if (existing_slot != NULL)
				{
					str = &(existing_slot->data);
					appendBinaryStringInfo(str,
								 cursor + PIPE_HEADER_SIZE,
								 p.len);
					write_syslogger_file(str->data, str->len, dest);
					/* 标记缓冲区未使用，并回收字符串存储 */
					existing_slot->pid = 0;
					pfree(str->data);
				}
				else
				{
					/* 显然，整个消息只有一个块。 */
					write_syslogger_file(cursor + PIPE_HEADER_SIZE, p.len,
								 dest);
				}
			}

			/* 完成处理此块 */
			cursor += chunklen;
			count -= chunklen;
		}
		else
		{
			/* 处理非协议数据 */

			/*
			 * 寻找协议头部的开始。如果找到，将数据转储到那里并重复循环。
			 * 否则，将其全部转储并退出循环。（注意：如果可能，我们希望将其全部转储，
			 * 以避免跨日志文件分割非协议消息。我们期望在许多场景中，
			 * 非协议消息将一次性到达read()，如果可能，我们希望尊重read()边界。）
			 */
			for (chunklen = 1; chunklen < count; chunklen++)
			{
				if (cursor[chunklen] == '\0')
					break;
			}
			/* 回退到stderr日志作为目的地 */
			write_syslogger_file(cursor, chunklen, LOG_DESTINATION_STDERR);
			cursor += chunklen;
			count -= chunklen;
		}
	}

	/* 我们没有完整的块，所以将缓冲区中剩余的内容左对齐 */
	if (count > 0 && cursor != logbuffer)
		memmove(logbuffer, cursor, count);
	*bytes_in_logbuffer = count;
}

/*
 * 强制输出任何缓冲的数据
 *
 * 这当前仅在syslogger关闭时使用，但在其他时候可能也有用，因此它小心地保持事物处于干净状态。
 */
static void
flush_pipe_input(char *logbuffer, int *bytes_in_logbuffer)
{
	int		i;

	/* 转储任何不完整的协议消息 */
	for (i = 0; i < NBUFFER_LISTS; i++)
	{
		List		*list = buffer_lists[i];
		ListCell	*cell;

		foreach(cell, list)
		{
			save_buffer *buf = (save_buffer *) lfirst(cell);

			if (buf->pid != 0)
			{
				StringInfo	str = &(buf->data);

				write_syslogger_file(str->data, str->len,
								 LOG_DESTINATION_STDERR);
				/* 标记缓冲区未使用，并回收字符串存储 */
				buf->pid = 0;
				pfree(str->data);
			}
		}
	}

	/*
	 * 强制输出任何剩余的管道数据原样；我们不费心尝试删除其中可能存在的任何协议头部。
	 */
	if (*bytes_in_logbuffer > 0)
		write_syslogger_file(logbuffer, *bytes_in_logbuffer,
					 LOG_DESTINATION_STDERR);
	*bytes_in_logbuffer = 0;
}


/* ------------------------------
 *		日志文件例程
 * ------------------------------
 */

/*
 * 向当前打开的日志文件写入文本
 *
 * 这被导出，以便当MyBackendType是B_LOGGER时，elog.c可以调用它。
 * 这允许syslogger进程记录自己的elog消息，即使其stderr不指向syslog管道。
 */
void
write_syslogger_file(const char *buffer, int count, int destination)
{
	int		rc;
	FILE	*logfile;

	/*
	 * 如果我们被告知写入结构化日志文件，但它没有打开，
	 * 则将数据转储到syslogFile（始终打开）而不是。这可能发生在
	 * postmaster启动后启用结构化输出并且我们无法打开logFile的情况下。
	 * 在参数更改期间也存在竞争条件，后端可能在我们打开logFile之前或关闭它之后向我们发送结构化输出。
	 * 将格式化输出写入常规日志文件不是很好，但总比将日志输出丢在地上好。
	 *
	 * 不要试图通过尝试动态打开logFile来改进这一点。任何失败都会导致递归。
	 */
	if ((destination & LOG_DESTINATION_CSVLOG) && csvlogFile != NULL)
		logfile = csvlogFile;
	else if ((destination & LOG_DESTINATION_JSONLOG) && jsonlogFile != NULL)
		logfile = jsonlogFile;
	else
		logfile = syslogFile;

	rc = fwrite(buffer, 1, count, logfile);

	/*
	 * 尝试报告任何失败。我们不能使用ereport，因为它会直接递归回到这里，
	 * 但write_stderr是可以的：它将写入postmaster的原始stderr或/dev/null，
	 * 但永远不会写入我们的输入管道，这会导致不同类型的循环。
	 */
	if (rc != count)
		write_stderr("无法写入日志文件: %m\n");
}

#ifdef WIN32

/*
 * 工作线程，用于将数据从管道传输到当前日志文件。
 *
 * 我们需要这个，因为在Windows上，WaitForMultipleObjects在未命名管道上不起作用：
 * 它总是报告"信号化"，所以阻塞的ReadFile不会允许SIGHUP；而select仅适用于套接字。
 */
static unsigned int __stdcall
pipeThread(void *arg)
{
	char	logbuffer[READ_BUF_SIZE];
	int	bytes_in_logbuffer = 0;

	for (;;)
	{
		DWORD		bytesRead;
		BOOL		result;

		result = ReadFile(syslogPipe[0],
				 logbuffer + bytes_in_logbuffer,
				 sizeof(logbuffer) - bytes_in_logbuffer,
				 &bytesRead, 0);

		/*
		 * 在执行任何可能触摸主线程共享的全局状态的操作之前进入临界区。
		 * 特别是任何使用palloc()/pfree()的操作在临界区外都是不安全的。
		 */
		EnterCriticalSection(&sysloggerSection);
		if (!result)
		{
			DWORD		error = GetLastError();

			if (error == ERROR_HANDLE_EOF ||
				error == ERROR_BROKEN_PIPE)
				break;
			_dosmaperr(error);
			eblog(LOG,
				 (errcode_for_file_access(),
				 errmsg("无法从日志管道读取: %m")));
		}
		else if (bytesRead > 0)
		{
			bytes_in_logbuffer += bytesRead;
			process_pipe_input(logbuffer, &bytes_in_logbuffer);
		}

		/*
		 * 如果我们已经填满了当前日志文件，轻推主线程进行日志轮换。
		 */
		if (Log_RotationSize > 0)
		{
			if (ftell(syslogFile) >= Log_RotationSize * 1024L ||
				(csvlogFile != NULL && ftell(csvlogFile) >= Log_RotationSize * 1024L) ||
				(jsonlogFile != NULL && ftell(jsonlogFile) >= Log_RotationSize * 1024L))
				SetLatch(MyLatch);
		}
		LeaveCriticalSection(&sysloggerSection);
	}

	/* 我们只在检测到管道EOF时退出上面的循环 */
	pipe_eof_seen = true;

	/* 如果还有任何数据剩余，则立即强制输出 */
	flush_pipe_input(logbuffer, &bytes_in_logbuffer);

	/* 设置latch以唤醒主线程，它将退出 */
	SetLatch(MyLatch);

	LeaveCriticalSection(&sysloggerSection);
	_endthread();
	return 0;
}
#endif						/* WIN32 */

/*
 * 以适当的权限和缓冲选项打开新的日志文件。
 *
 * 如果allow_errors为true，我们只记录任何打开失败并返回NULL
 * （errno仍然对fopen失败正确）。
 * 否则，错误被视为致命。
 */
static FILE *
logfile_open(const char *filename, const char *mode, bool allow_errors)
{
	FILE	*fh;
	mode_t	oumask;

	/*
	 * 注意我们不让Log_file_mode禁用IWUSR，因为我们肯定希望能够自己写入文件。
	 */
	oumask = umask((mode_t) ((~(Log_file_mode | S_IWUSR)) & (S_IRWXU | S_IRWXG | S_IRWXO)));
	fh = fopen(filename, mode);
	umask(oumask);

	if (fh)
	{
		setvbuf(fh, NULL, PG_IOLBF, 0);

#ifdef WIN32
		/* 在Windows上使用CRLF行结尾 */
		_setmode(_fileno(fh), _O_TEXT);
#endif
	}
	else
	{
		int		save_errno = errno;

		eblog(allow_errors ? LOG : FATAL,
			 (errcode_for_file_access(),
			  errmsg("无法打开日志文件\"%s\": %m",
				 filename)));
		errno = save_errno;
	}

	return fh;
}

/*
 * 为单个目标执行日志文件轮换，由target_dest指定。
 * 在成功的文件轮换时，存储在*last_file_name和*logFile中的信息会更新。
 *
 * 如果轮换已停止，返回false，或者返回true以继续处理其他格式。
 */
static bool
logfile_rotate_dest(bool time_based_rotation, int size_rotation_for,
			  pg_time_t fntime, int target_dest,
			  char **last_file_name, FILE **logFile)
{
	char	*logFileExt = NULL;
	char	*filename;
	FILE	*fh;

	/*
	 * 如果目标目的地刚刚关闭，关闭先前的文件并注销其数据。
	 * 这对于stderr不可能发生，因为假设即使在log_destination中禁用stderr，syslogFile也始终打开。
	 */
	if ((Log_destination & target_dest) == 0 &&
		target_dest != LOG_DESTINATION_STDERR)
	{
		if (*logFile != NULL)
			fclose(*logFile);
		*logFile = NULL;
		if (*last_file_name != NULL)
			pfree(*last_file_name);
		*last_file_name = NULL;
		return true;
	}

	/*
	 * 如果不是轮换时间，或者目标目的地基于其文件大小无需轮换，则离开。
	 */
	if (!time_based_rotation && (size_rotation_for & target_dest) == 0)
		return true;

	/* 文件扩展名取决于目标类型 */
	if (target_dest == LOG_DESTINATION_STDERR)
		logFileExt = NULL;
	else if (target_dest == LOG_DESTINATION_CSVLOG)
		logFileExt = ".csv";
	else if (target_dest == LOG_DESTINATION_JSONLOG)
		logFileExt = ".json";
	else
	{
		/* 不可能发生 */
		Assert(false);
	}

	/* 构建新文件名 */
	filename = logfile_getname(fntime, logFileExt);

	/*
	 * 决定是覆盖还是追加。如果 (a) 设置了Log_truncate_on_rotation，
	 * (b) 轮换是由经过的时间触发的，而不是其他原因，以及
	 * (c) 计算的文件名与我们之前登录的文件名不同，我们可以覆盖。
	 */
	if (Log_truncate_on_rotation && time_based_rotation &&
		*last_file_name != NULL &&
		strcmp(filename, *last_file_name) != 0)
		fh = logfile_open(filename, "w", true);
	else
		fh = logfile_open(filename, "a", true);

	if (!fh)
	{
		/*
		 * 在繁忙的系统上，ENFILE/EMFILE并不太令人惊讶；继续使用旧文件，直到我们成功获取新文件。
		 * 否则，假设Log_directory有问题，停止尝试创建文件。
		 */
		if (errno != ENFILE && errno != EMFILE)
		{
			eblog(LOG,
				 (errmsg("禁用自动轮换（使用SIGHUP重新启用）")));
			rotation_disabled = true;
		}

		if (filename)
			pfree(filename);
		return false;
	}

	/* 填写新信息 */
	if (*logFile != NULL)
		fclose(*logFile);
	*logFile = fh;

	/* 不是pfree文件名，而是记住它以备下次使用 */
	if (*last_file_name != NULL)
		pfree(*last_file_name);
	*last_file_name = filename;

	return true;
}

/*
 * 执行日志文件轮换
 */
static void
logfile_rotate(bool time_based_rotation, int size_rotation_for)
{
	pg_time_t	fntime;

	rotation_requested = false;

	/*
	 * 当做基于时间的轮换时，基于计划的轮换时间而不是当前时间发明新的日志文件名，
	 * 以避免当我们不立即执行轮换时文件名中的"滑动"。
	 */
	if (time_based_rotation)
		fntime = next_rotation_time;
	else
		fntime = time(NULL);

	/* stderr的文件轮换 */
	if (!logfile_rotate_dest(time_based_rotation, size_rotation_for, fntime,
				 LOG_DESTINATION_STDERR, &last_sys_file_name,
				 &syslogFile))
		return;

	/* csvlog的文件轮换 */
	if (!logfile_rotate_dest(time_based_rotation, size_rotation_for, fntime,
				 LOG_DESTINATION_CSVLOG, &last_csv_file_name,
				 &csvlogFile))
		return;

	/* jsonlog的文件轮换 */
	if (!logfile_rotate_dest(time_based_rotation, size_rotation_for, fntime,
				 LOG_DESTINATION_JSONLOG, &last_json_file_name,
				 &jsonlogFile))
		return;

	update_metainfo_datafile();

	set_next_rotation_time();
}


/*
 * 使用时间戳信息构造日志文件名
 *
 * 如果suffix不为NULL，将其附加到名称，替换模式中可能存在的任何".log"。
 *
 * 结果是palloc'd。
 */
static char *
logfile_getname(pg_time_t timestamp, const char *suffix)
{
	char	*filename;
	int		len;

	filename = palloc(MAXPGPATH);

	snprintf(filename, MAXPGPATH, "%s/", Log_directory);

	len = strlen(filename);

	/* 将Log_filename视为strftime模式 */
	pg_strftime(filename + len, MAXPGPATH - len, Log_filename,
			pg_localtime(&timestamp, log_timezone));

	if (suffix != NULL)
	{
		len = strlen(filename);
		if (len > 4 && (strcmp(filename + (len - 4), ".log") == 0))
			len -= 4;
		strlcpy(filename + len, suffix, MAXPGPATH - len);
	}

	return filename;
}

/*
 * 确定下一次计划的轮换时间，并存储在next_rotation_time中。
 */
static void
set_next_rotation_time(void)
{
	pg_time_t	now;
	struct pg_tm *tm;
	int		rotinterval;

	/* 如果禁用基于时间的轮换，则无需执行任何操作 */
	if (Log_RotationAge <= 0)
		return;

	/*
	 * 这里的要求是选择下一个时间 > now，这是日志轮换间隔的"倍数"。
	 * "倍数"可以相当宽松地解释。在这个版本中，我们对齐到log_timezone而不是GMT。
	 */
	rotinterval = Log_RotationAge * SECS_PER_MINUTE;	/* 转换为秒 */
	now = (pg_time_t) time(NULL);
	tm = pg_localtime(&now, log_timezone);
	now += tm->tm_gmtoff;
	now -= now % rotinterval;
	now += rotinterval;
	now -= tm->tm_gmtoff;
	next_rotation_time = now;
}

/*
 * 存储日志收集器（如果启用）写入日志消息的文件的名称。
 * 当存在基于时间的日志文件轮换时，这对于查找当前日志文件的名称很有用。
 * 文件名存储在临时文件中，并将其重命名为最终目标以实现原子性。
 * 该文件以与数据目录中创建的权限相同的权限打开，并具有适当的缓冲选项。
 */
static void
update_metainfo_datafile(void)
{
	FILE	*fh;
	mode_t	oumask;

	if (!(Log_destination & LOG_DESTINATION_STDERR) &&
		!(Log_destination & LOG_DESTINATION_CSVLOG) &&
		!(Log_destination & LOG_DESTINATION_JSONLOG))
	{
		if (unlink(LOG_METAINFO_DATAFILE) < 0 && errno != ENOENT)
			eblog(LOG,
				 (errcode_for_file_access(),
				 errmsg("无法删除文件\"%s\": %m",
					 LOG_METAINFO_DATAFILE)));
		return;
	}

	/* 对新文件使用与数据目录相同的权限 */
	oumask = umask(pg_mode_mask);
	fh = fopen(LOG_METAINFO_DATAFILE_TMP, "w");
	umask(oumask);

	if (fh)
	{
		setvbuf(fh, NULL, PG_IOLBF, 0);

#ifdef WIN32
		/* 在Windows上使用CRLF行结尾 */
		_setmode(_fileno(fh), _O_TEXT);
#endif
	}
	else
	{
		eblog(LOG,
			 (errcode_for_file_access(),
			  errmsg("无法打开文件\"%s\": %m",
				 LOG_METAINFO_DATAFILE_TMP)));
		return;
	}

	if (last_sys_file_name && (Log_destination & LOG_DESTINATION_STDERR))
	{
		if (fprintf(fh, "stderr %s\n", last_sys_file_name) < 0)
		{
			eblog(LOG,
				 (errcode_for_file_access(),
				 errmsg("无法写入文件\"%s\": %m",
					 LOG_METAINFO_DATAFILE_TMP)));
			fclose(fh);
			return;
		}
	}

	if (last_csv_file_name && (Log_destination & LOG_DESTINATION_CSVLOG))
	{
		if (fprintf(fh, "csvlog %s\n", last_csv_file_name) < 0)
		{
			eblog(LOG,
				 (errcode_for_file_access(),
				 errmsg("无法写入文件\"%s\": %m",
					 LOG_METAINFO_DATAFILE_TMP)));
			fclose(fh);
			return;
		}
	}

	if (last_json_file_name && (Log_destination & LOG_DESTINATION_JSONLOG))
	{
		if (fprintf(fh, "jsonlog %s\n", last_json_file_name) < 0)
		{
			eblog(LOG,
				 (errcode_for_file_access(),
				 errmsg("无法写入文件\"%s\": %m",
					 LOG_METAINFO_DATAFILE_TMP)));
			fclose(fh);
			return;
		}
	}
	fclose(fh);

	if (rename(LOG_METAINFO_DATAFILE_TMP, LOG_METAINFO_DATAFILE) != 0)
		eblog(LOG,
			 (errcode_for_file_access(),
			  errmsg("无法将文件\"%s\"重命名为\"%s\": %m",
				 LOG_METAINFO_DATAFILE_TMP, LOG_METAINFO_DATAFILE)));
}

/* ------------------------------
 *		信号处理程序例程
 * ------------------------------
 */

/*
 * 检查是否已收到日志轮换请求。应在postmaster收到SIGUSR1后调用。
 */
bool
CheckLogrotateSignal(void)
{
	struct stat stat_buf;

	if (stat(LOGROTATE_SIGNAL_FILE, &stat_buf) == 0)
		return true;

	return false;
}

/*
 * 移除发出日志轮换请求的文件。
 */
void
RemoveLogrotateSignalFiles(void)
{
	unlink(LOGROTATE_SIGNAL_FILE);
}

/* SIGUSR1：设置标志以轮换日志文件 */
static void
sigUsr1Handler(SIGNAL_ARGS)
{
	rotation_requested = true;
	SetLatch(MyLatch);
}